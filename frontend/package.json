{
  "name": "authdrop-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AuthDrop portal: login, account settings and developer console",
  "engines": { "node": ">=22.18.0 <25" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
