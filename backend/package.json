{
  "name": "authdrop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AuthDrop passwordless OIDC identity provider - API",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "user:promote": "tsx scripts/promote-user.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.0",
    "oidc-provider": "9.12.2",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
