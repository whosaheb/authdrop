# ───────────── Core ─────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public origin of the whole product (SPA + API + /oauth are served under ONE origin).
APP_URL=http://localhost:5173
# Set true when running behind a reverse proxy / load balancer that sets X-Forwarded-* headers.
TRUST_PROXY=false

# ───────────── Data stores ─────────────
DATABASE_URL=postgresql://authdrop:authdrop@localhost:5432/authdrop?schema=public
REDIS_URL=redis://:authdrop@localhost:6379

# ───────────── Secrets (generate with: npm run keys:generate) ─────────────
# 32 random bytes, base64 encoded. Encrypts TOTP secrets and client secrets (AES-256-GCM).
ENCRYPTION_KEY=
# >= 32 chars. Peppers OTP / backup-code hashes.
HMAC_PEPPER=
# Comma-separated list, each >= 32 chars. First key signs, the rest only verify (rotation).
OIDC_COOKIE_KEYS=
# Signing keys as a JWKS JSON string OR a file path. Required in production.
OIDC_JWKS=
OIDC_JWKS_PATH=./secrets/jwks.json

# ───────────── OIDC behaviour ─────────────
OIDC_REQUIRE_PKCE=true

# ───────────── Sessions ─────────────
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800

# ───────────── Email OTP ─────────────
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ───────────── Mail (Nodemailer). Dev: Mailpit from docker-compose (localhost:1025) ─────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AuthDrop <no-reply@authdrop.local>"

# ───────────── Cloudflare R2 (profile pictures). Optional: leave empty to disable uploads ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL that serves the bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_BASE_URL=

# ───────────── Social login (each provider is enabled only when BOTH values are set) ─────────────
# Callback URL to register at each provider: {APP_URL}/api/auth/social/{google|github|facebook|linkedin}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ───────────── Developer console / ops ─────────────
# Let any signed-in user enroll as a developer from the console.
DEVELOPER_SELF_ENROLL=true
SWAGGER_ENABLED=true
AUDIT_RETENTION_DAYS=365
